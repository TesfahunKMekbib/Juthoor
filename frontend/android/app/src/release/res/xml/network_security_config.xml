<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds only (src/release). Demo connectivity to the local NestJS backend over the laptop's Windows
     Mobile Hotspot, whose host address is always 192.168.137.1. Plain HTTP is allowed to that single local
     address only; every other host still requires HTTPS (Android default). Debug builds are unaffected. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.137.1</domain>
    </domain-config>
</network-security-config>
