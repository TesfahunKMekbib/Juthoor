{
  "name": "juthoor-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Juthoor backend (NestJS + MongoDB).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "seed:dev": "node scripts/build.mjs && node --env-file-if-exists=.env dist/src/dev/seed.js",
    "typecheck":"tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests --testPathIgnorePatterns \"/node_modules/\" \"/dist/\" \"\\.e2e-spec\\.ts$\"",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests --coverage --testPathIgnorePatterns \"/node_modules/\" \"/dist/\" \"\\.e2e-spec\\.ts$\"",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.e2e.config.cjs --runInBand",
    "verify": "npm run typecheck && npm run lint && npm run test:cov"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/mongoose": "^12.0.1",
    "@nestjs/platform-express": "^12.6.0",
    "mongoose": "^9.12.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
